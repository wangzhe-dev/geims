/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  min-height: 100vh;
}

/* 顶部区域 */
.header {
  width: 100%;
  max-width: 500rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 80rpx;
  font-weight: bold;
  color: #776e65;
}

.score-container {
  display: flex;
  gap: 20rpx;
}

.score-box {
  background: #bbada0;
  padding: 15rpx 25rpx;
  border-radius: 6rpx;
  text-align: center;
  min-width: 100rpx;
}

.score-label {
  font-size: 24rpx;
  color: #eee4da;
  margin-bottom: 5rpx;
}

.score {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

/* 游戏说明 */
.intro {
  font-size: 28rpx;
  color: #776e65;
  margin-bottom: 30rpx;
  text-align: center;
  max-width: 500rpx;
}

.highlight {
  color: #f67c5f;
  font-weight: bold;
}

/* 新游戏按钮 */
.btn-new-game {
  background: #8f7a66;
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 6rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  cursor: pointer;
}

/* 游戏棋盘 */
.game-board {
  position: relative;
  width: 500rpx;
  height: 500rpx;
  background: #bbada0;
  border-radius: 12rpx;
  padding: 15rpx;
  box-sizing: border-box;
}

/* 背景格子 */
.grid-container {
  position: absolute;
  width: 470rpx;
  height: 470rpx;
}

.grid-row {
  display: flex;
  margin-bottom: 15rpx;
}

.grid-row:last-child {
  margin-bottom: 0;
}

.grid-cell {
  width: 106.25rpx;
  height: 106.25rpx;
  background: rgba(238, 228, 218, 0.35);
  border-radius: 6rpx;
  margin-right: 15rpx;
}

.grid-cell:last-child {
  margin-right: 0;
}

/* 数字方块容器 */
.tile-container {
  position: absolute;
  width: 470rpx;
  height: 470rpx;
}

/* 数字方块 */
.tile {
  position: absolute;
  width: 106.25rpx;
  height: 106.25rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease-in-out;
  font-weight: bold;
}

.tile-inner {
  font-size: 50rpx;
}

/* 方块位置 */
.tile-position-0-0 { top: 0rpx; left: 0rpx; }
.tile-position-0-1 { top: 0rpx; left: 121.25rpx; }
.tile-position-0-2 { top: 0rpx; left: 242.5rpx; }
.tile-position-0-3 { top: 0rpx; left: 363.75rpx; }
.tile-position-1-0 { top: 121.25rpx; left: 0rpx; }
.tile-position-1-1 { top: 121.25rpx; left: 121.25rpx; }
.tile-position-1-2 { top: 121.25rpx; left: 242.5rpx; }
.tile-position-1-3 { top: 121.25rpx; left: 363.75rpx; }
.tile-position-2-0 { top: 242.5rpx; left: 0rpx; }
.tile-position-2-1 { top: 242.5rpx; left: 121.25rpx; }
.tile-position-2-2 { top: 242.5rpx; left: 242.5rpx; }
.tile-position-2-3 { top: 242.5rpx; left: 363.75rpx; }
.tile-position-3-0 { top: 363.75rpx; left: 0rpx; }
.tile-position-3-1 { top: 363.75rpx; left: 121.25rpx; }
.tile-position-3-2 { top: 363.75rpx; left: 242.5rpx; }
.tile-position-3-3 { top: 363.75rpx; left: 363.75rpx; }

/* 方块颜色 */
.tile-2 { background: #eee4da; color: #776e65; }
.tile-4 { background: #ede0c8; color: #776e65; }
.tile-8 { background: #f2b179; color: #f9f6f2; }
.tile-16 { background: #f59563; color: #f9f6f2; }
.tile-32 { background: #f67c5f; color: #f9f6f2; }
.tile-64 { background: #f65e3b; color: #f9f6f2; }
.tile-128 { background: #edcf72; color: #f9f6f2; }
.tile-128 .tile-inner { font-size: 45rpx; }
.tile-256 { background: #edcc61; color: #f9f6f2; }
.tile-256 .tile-inner { font-size: 45rpx; }
.tile-512 { background: #edc850; color: #f9f6f2; }
.tile-512 .tile-inner { font-size: 45rpx; }
.tile-1024 { background: #edc53f; color: #f9f6f2; }
.tile-1024 .tile-inner { font-size: 35rpx; }
.tile-2048 { background: #edc22e; color: #f9f6f2; }
.tile-2048 .tile-inner { font-size: 35rpx; }

/* 新方块动画 */
.tile-new {
  animation: appear 0.2s ease-in-out;
}

@keyframes appear {
  0% {
    transform: scale(0);
  }
  100% {
    transform: scale(1);
  }
}

/* 合并动画 */
.tile-merged {
  animation: merge 0.2s ease-in-out;
}

@keyframes merge {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}

/* 游戏结束遮罩 */
.game-over-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(238, 228, 218, 0.73);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.game-over-message {
  background: white;
  padding: 60rpx;
  border-radius: 12rpx;
  text-align: center;
  box-shadow: 0 0 30rpx rgba(0, 0, 0, 0.1);
}

.message-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #776e65;
  margin-bottom: 20rpx;
}

.message-score {
  font-size: 32rpx;
  color: #776e65;
  margin-bottom: 40rpx;
}

.btn-restart {
  background: #8f7a66;
  color: white;
  padding: 20rpx 60rpx;
  border-radius: 6rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: inline-block;
}
